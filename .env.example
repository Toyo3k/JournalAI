# Copy to .env.local and fill in.

# Required for Robinhood Chain wallets (chain 4663), via Etherscan's multichain V2 API.
# Free key: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Required for Solana wallets, via Helius' enhanced transactions API.
# Free key: https://dashboard.helius.dev
HELIUS_API_KEY=

# Optional but recommended. Raises the rate limit for the ETH/USD and SOL/USD prices used to value swaps,
# and lets the fumble check price 12 sold tokens instead of 4.
# Free demo key: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Optional. The public origin of the site, used for share card image URLs.
# Set it in production (for example https://neurox.example). Defaults to localhost.
NEXT_PUBLIC_SITE_URL=
