# Copy to .env.local and fill in.

# Required. Robinhood Chain (chain 4663) via Etherscan's multichain V2 API.
# Free key: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional. Raises the rate limit for the ETH/USD prices used to value swaps.
# Free demo key: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Optional. The public origin of the site, used for share card image URLs.
# Set it in production (for example https://journalai.example). Defaults to localhost.
NEXT_PUBLIC_SITE_URL=
